# ==============================================================================
# DukaanKhata Environment Configuration Template
# Copy this file to '.env' and populate with your local values.
# NEVER commit the actual '.env' file containing secrets to GitHub!
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Allowed CORS Origins (comma-separated list for Express CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Admin Secret Key
# Used to authenticate sensitive operations (e.g., /api/backup, /api/backup/restore)
# IMPORTANT: In production, generate a secure random secret key!
ADMIN_SECRET=change-this-to-a-secure-random-secret

# JWT Secret
# Used to sign and verify JSON Web Tokens for user authentication.
# IMPORTANT: In production, replace with a long, random, high-entropy string.
#   e.g. node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
